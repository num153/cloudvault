# ==============================================================================
# CloudVault - Cấu hình biến môi trường mẫu (.env.example)
# Sao chép tệp này thành .env trước khi khởi chạy hệ thống: cp .env.example .env
# ==============================================================================

# ----------------- CHUNG & PORT -----------------
PROJECT_NAME=CloudVault
ENVIRONMENT=development
NGINX_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ----------------- POSTGRESQL DATABASE -----------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cloudvault_db
POSTGRES_USER=cloudvault_user
POSTGRES_PASSWORD=cloudvault_secure_password_123

# Database URL dùng cho ORM (SQLAlchemy / Prisma / TypeORM)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----------------- S3 / MINIO OBJECT STORAGE -----------------
# Tài khoản root quản trị MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_DEFAULT_BUCKET=cloudvault-data

# Endpoint nội bộ kết nối giữa backend và MinIO
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword123
S3_BUCKET_NAME=cloudvault-data
S3_REGION=us-east-1

# Endpoint công khai cho trình duyệt truy cập Presigned URL
# Local: http://localhost:9000 (hoặc qua Nginx /s3)
# Trên AWS EC2: http://<EC2_PUBLIC_IP>:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ----------------- BẢO MẬT & JWT AUTHENTICATION -----------------
# Khóa bí mật dùng để ký access token JWT (Nên sinh ngẫu nhiên: openssl rand -hex 32)
JWT_SECRET_KEY=replace_this_with_a_super_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------- GỬI EMAIL (SMTP) -----------------
# Dùng Gmail App Password hoặc dịch vụ sandbox Mailtrap
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=no-reply@cloudvault.com

# ----------------- CỔNG THANH TOÁN SANDBOX -----------------
# VNPay Sandbox credentials
VNPAY_TMN_CODE=TEST_TMN_CODE
VNPAY_HASH_SECRET=TEST_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost/api/v1/payments/vnpay-return

# Stripe Test Mode (Tùy chọn nếu dùng Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
